# Trail Guardian App Environment Variables
# Copy this file to .env and add your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Note: 
# 1. Get your API key from https://platform.openai.com/api-keys
# 2. Copy this file to .env and replace with your actual key
# 3. Never commit .env files to version control
# 4. You can also set the API key directly in the app settings
